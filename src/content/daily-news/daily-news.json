      "id": "news.daily-leader.01",
      "event": "daily-leader",
      "topic": "daily-lead",
      "priority": 70,
      "conditions": {
        "all": [
          {
            "fact": "context.dataScope",
            "op": "eq",
            "value": "unlocked-records"
          },
          {
            "fact": "context.factsValidated",
            "op": "eq",
            "value": true
          },
          {
            "fact": "context.sameGroup",
            "op": "eq",
            "value": true
          },
          {
            "fact": "day.playerCount",
            "op": "gte",
            "value": 1
          },
          {
            "fact": "player.gamesPlayed",
            "op": "gte",
            "value": 1
          },
          {
            "fact": "player.isSoleDailyLeader",
            "op": "eq",
            "value": true
          },
          {
            "fact": "player.totalResult",
            "op": "gt",
            "value": 0
          },
          {
            "fact": "day.playerCount",
            "op": "gte",
            "value": 4
          }
        ]
      },
      "requiredFacts": [
        "context.dataScope",
        "context.factsValidated",
        "context.sameGroup",
        "day.date",
        "day.playerCount",
        "player.gamesPlayed",
        "player.id",
        "player.isSoleDailyLeader",
        "player.name",
        "player.totalResult"
      ],
      "placeholders": [
        "player.gamesPlayed",
        "player.name",
        "player.totalResult"
      ],
      "text": "日次集計では{player.name}が単独首位。{player.gamesPlayed}戦の合計は{player.totalResult}ptとなっています。"
    },
