  "grammars": [
    {
      "id": "term-action",
      "pattern": "{role}?の?{term}?を?{role2}?{action}(?:で)?{all}?",
      "example": "親倍満をツモで8000オール"
    },
    {
      "id": "action-result",
      "pattern": "{role}?の?{action}で{term}",
      "example": "ツモで倍満"
    },
    {
      "id": "term-noun",
      "pattern": "{role}?の?{term}の{action}",
      "example": "倍満のツモ"
    },
    {
      "id": "term-means",
      "pattern": "{role}?の?{term}で{action}",
      "example": "倍満でツモ"
    },
    {
      "id": "action-method",
      "pattern": "{role}?の?{term}を{action}で和了",
      "example": "倍満をツモで和了"
    },
    {
      "id": "role-position",
      "pattern": "{role}として{term}を?{action}",
      "example": "親として倍満をツモ"
    },
    {
      "id": "role-turn",
      "pattern": "{role}番で{term}を?{action}",
      "example": "親番で倍満をツモ"
    },
    {
      "id": "action-parenthesis",
      "pattern": "{role}?の?{term}を?和了\\({action}\\)",
      "example": "倍満を和了(ツモ)"
    },
    {
      "id": "result-parenthesis",
      "pattern": "{role}?の?{action}\\({term}\\)",
      "example": "ツモ(倍満)"
    },
    {
      "id": "explicit-success",
      "pattern": "{role}?の?{term}の{action}に成功",
      "example": "倍満のツモに成功"
    }
  ],
  "aliasBoundaries": {
    "チートイツ": "モ",
    "ちーといつ": "も"
  }
}
