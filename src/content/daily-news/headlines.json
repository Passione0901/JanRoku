          {
            "fact": "context.factsValidated",
            "op": "eq",
            "value": true
          },
          {
            "fact": "context.sameGroup",
            "op": "eq",
            "value": true
          },
          {
            "fact": "day.playerCount",
            "op": "gte",
            "value": 1
          },
          {
            "fact": "player.gamesPlayed",
            "op": "gte",
            "value": 1
          },
          {
            "fact": "player.isSoleDailyLeader",
            "op": "eq",
            "value": true
          },
          {
            "fact": "player.totalResult",
            "op": "gt",
            "value": 0
          },
          {
            "fact": "day.playerCount",
            "op": "gte",
            "value": 4
          }
        ]
      },
      "requiredFacts": [
        "context.dataScope",
        "context.factsValidated",
        "context.sameGroup",
        "day.date",
        "day.playerCount",
        "player.gamesPlayed",
        "player.id",
        "player.isSoleDailyLeader",
        "player.name",
        "player.totalResult"
      ],
      "placeholders": [
        "player.name",
        "player.totalResult"
      ],
      "text": "{player.name}が本日の単独首位！{player.totalResult}ptでライバルをリード"
